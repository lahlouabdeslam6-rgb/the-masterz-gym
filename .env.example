# Copy this file to .env for local Docker Compose development.
POSTGRES_DB=masterz_gym
POSTGRES_USER=masterz
POSTGRES_PASSWORD=masterz_local_only
DATABASE_URL=postgresql+psycopg://masterz:masterz_local_only@postgres:5432/masterz_gym
REDIS_URL=redis://redis:6379/0
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
GYM_TIMEZONE=Africa/Casablanca
JWT_SECRET_KEY=masterz-local-jwt-secret-change-me-2026
JWT_REFRESH_SECRET_KEY=masterz-local-refresh-secret-change-me-2026
CORS_ORIGINS=["http://localhost:3000","http://localhost:13000"]
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Optional host-port overrides when the defaults are already occupied.
MASTERZ_WEB_PORT=3000
MASTERZ_API_PORT=8000
