{
  "name": "@masterz/api-client",
  "version": "0.2.0",
  "private": true,
  "description": "Client TypeScript généré depuis l'OpenAPI FastAPI.",
  "type": "module",
  "exports": "./src/index.ts",
  "files": ["src", "openapi.json"],
  "scripts": {
    "generate": "openapi-typescript ./openapi.json -o ./src/schema.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.14.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.10.1",
    "typescript": "^5.8.0"
  }
}
